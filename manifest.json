{
  "manifest_version": 3,
  "name": "Manga/Novel Tracker",
  "version": "0.2.0",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://fenrirealm.com/*",
    "https://www.fenrirealm.com/*",
    "https://helioscans.com/*",
    "https://asuracomic.net/*",
    "https://www.asuracomic.net/*",
    "https://asurascans.com/*",
    "https://www.asurascans.com/*",
    "https://beta.asurascans.com/*",
    "https://manganato.gg/*",
    "https://www.manganato.gg/*",
    "https://mangakakalot.gg/*",
    "https://www.mangakakalot.gg/*",
    "https://novelbin.com/*",
    "https://www.novelbin.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fenrirealm.com/series/*",
        "https://www.fenrirealm.com/series/*",
        "https://helioscans.com/chapter/*",
        "https://asuracomic.net/series/*/chapter/*",
        "https://www.asuracomic.net/series/*/chapter/*",
        "https://asurascans.com/series/*/chapter/*",
        "https://www.asurascans.com/series/*/chapter/*",
        "https://beta.asurascans.com/series/*/chapter/*",
        "https://manganato.gg/manga/*/chapter*",
        "https://www.manganato.gg/manga/*/chapter*",
        "https://mangakakalot.gg/manga/*/chapter*",
        "https://www.mangakakalot.gg/manga/*/chapter*"
      ],
      "js": ["dist/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga/Novel Tracker"
  },
  "options_page": "settings.html"
}
