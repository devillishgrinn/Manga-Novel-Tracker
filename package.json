{
  "name": "Manga/Novel Tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "build": "esbuild src/background.ts src/contentScript.ts src/popup.ts --bundle --outdir=dist --platform=browser --target=es2020",
  "watch": "esbuild src/background.ts src/contentScript.ts src/popup.ts --bundle --outdir=dist --platform=browser --target=es2020 --watch",
  "test": "vitest run tests/unit",
  "test:watch": "vitest",
  "test:integration": "vitest run tests/integration",
  "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "esbuild": "^0.27.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
